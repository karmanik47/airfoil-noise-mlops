# Путь к основной конфигурации
AIRFOIL_CONFIG_PATH=configs/config.yaml

# Значения, зависящие от среды запуска
AIRFOIL_MODEL_PATH=models/model.joblib
AIRFOIL_HOST=0.0.0.0
AIRFOIL_PORT=8000

# Локальное хранилище MLflow; для удалённого сервера значение заменяется
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=airfoil-noise-comparison